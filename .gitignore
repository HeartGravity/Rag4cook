data/neo4j_data/
data/neo4j_logs/
data/neo4j_plugins/

# 如果你的 CSV 原始数据集(nodes.csv/relationships.csv)非常庞大或涉及隐私，也可以取消下面两行的注释
# data/cypher/*.csv
# !data/cypher/sample_*.csv  # 可以保留一个脱敏的 sample 文件供他人参考

